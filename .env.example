# ---------------------------------------------------------------
# Copie para .env.local (desenvolvimento) e cadastre as mesmas
# variáveis na Vercel (Settings > Environment Variables).
# ---------------------------------------------------------------

# URL pública do site, sem barra no final (usada em SEO, OG e sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API). Só usadas no servidor, pelas API routes.
# A chave anon basta: as políticas RLS só permitem insert.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Analytics (opcional). Sem os IDs, track() não envia nada.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------
# Checkout (Stripe). Deixe false até o lançamento.
# Com false, os botões de plano levam ao formulário de lista de espera.
# Com true, levam ao Stripe Checkout e depois para /obrigado.
# ---------------------------------------------------------------
NEXT_PUBLIC_CHECKOUT_ENABLED=false

# Chave secreta (use sk_test_... enquanto testa)
STRIPE_SECRET_KEY=

# IDs de preço recorrente criados em Stripe > Product catalog (price_...)
STRIPE_PRICE_ESSENCIAL_MENSAL=
STRIPE_PRICE_ESSENCIAL_ANUAL=
STRIPE_PRICE_CRESCIMENTO_MENSAL=
STRIPE_PRICE_CRESCIMENTO_ANUAL=
STRIPE_PRICE_ESCALA_MENSAL=
STRIPE_PRICE_ESCALA_ANUAL=
